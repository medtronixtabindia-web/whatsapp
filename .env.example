# Supabase project settings (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Keep this value unchanged when moving an existing database so stored
# WhatsApp credentials remain decryptable. Generate 32 random bytes as hex.
ENCRYPTION_KEY=your-64-character-hex-key

# Public application URL. Use http://localhost:3000 locally and your HTTPS
# deployment URL in Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=en
ALLOWED_INVITE_HOSTS=localhost:3000

# Meta app settings used to validate WhatsApp webhooks.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Protects the automation and flow cron endpoints.
AUTOMATION_CRON_SECRET=replace-with-a-long-random-secret

# Optional behavior and tuning.
WHATSAPP_TEMPLATES_DRY_RUN=false
AI_REQUEST_TIMEOUT_MS=30000
AI_CONTEXT_MESSAGE_LIMIT=20

# Optional extra development hosts, separated by commas.
ALLOWED_DEV_ORIGINS=*.ngrok-free.dev
